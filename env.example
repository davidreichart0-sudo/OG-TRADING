########################################
# COST OVERVIEW — READ THIS FIRST
########################################
# Every default value below runs at $0. Nothing paid is required.
#
#  FREE, always, no signup:    DATABASE_URL, REDIS_URL (self-hosted via
#                               docker-compose), SOLANA_RPC_URLS/WS_URL
#                               (public endpoint), TELEGRAM_BOT_TOKEN
#                               (Telegram bots are 100% free), all safety/
#                               strategy/risk thresholds, website checks.
#  FREE, but needs a signup:   JUPITER_API_KEY (Jupiter's "Lite" plan on
#                               their Developer Platform is free — 25M
#                               credits/month, no card charge — but you do
#                               need to create an account to get a key),
#                               HELIUS_API_KEY (Helius free plan: 1M
#                               credits/month, also $0).
#  NO free tier — skip these
#  for $0 operation:           TWITTER_BEARER_TOKEN (X API has no usable
#                               free read tier — leave this blank and the
#                               bot just runs without X/Twitter signals,
#                               nothing breaks), YELLOWSTONE_GRPC_ENDPOINT
#                               (Geyser gRPC streaming is a paid add-on at
#                               every provider that offers it — leave
#                               LISTENER_MODE=rpc).
#
# The one real trade-off: LISTENER_MODE=rpc (free) is genuinely slower
# than a paid Geyser/gRPC feed. You still detect and analyze every new
# token, paper-trade, and (optionally) live-trade — you just won't have
# the same millisecond head start as a bot that pays for gRPC. If you
# later want to spend money on exactly one upgrade, this is the one that
# matters for "Geschwindigkeit" — everything else can stay free forever.
########################################

########################################
# DATABASE / CACHE — free, self-hosted via docker-compose
########################################
DATABASE_URL="postgresql://sniper:sniper@localhost:5432/sniper_bot?schema=public"
REDIS_URL="redis://localhost:6379"

########################################
# SOLANA RPC / LISTENER
########################################
# Comma-separated list. First = primary, rest = fallback (in order).
# FREE default: the public endpoint below. It's rate-limited and a couple
# of seconds behind the paid tiers, but it costs nothing and works out of
# the box. Optional free upgrade: sign up for Helius's or Alchemy's free
# tier (both $0/month) and put that URL here instead — meaningfully more
# reliable, still $0.
SOLANA_RPC_URLS="https://api.mainnet-beta.solana.com"
SOLANA_WS_URL="wss://api.mainnet-beta.solana.com"

# "rpc"  = plain onLogs() websocket subscription — FREE, works anywhere,
#          slower. Keep this for $0 operation.
# "grpc" = Yellowstone gRPC Geyser stream — PAID everywhere it's offered
#          (Helius LaserStream needs a Professional+ plan, similarly at
#          other providers). Only switch to this if you've decided speed
#          is worth paying for.
LISTENER_MODE="rpc"
YELLOWSTONE_GRPC_ENDPOINT=""
YELLOWSTONE_GRPC_TOKEN=""

# The on-chain program ID whose logs/instructions mark a new FOMO token /
# pool creation. FOMO does not publish a fixed public program ID doc page,
# so you MUST fill this in yourself:
#   1. Create (or find) one token on fomopad / fomo.family
#   2. Open the creation tx in Solscan/Solana Explorer
#   3. Copy the program ID that owns the "create"/"initialize" instruction
# Until this is set correctly, the listener will not detect real FOMO
# launches — see docs/SETUP.md.
FOMO_PROGRAM_ID=""

########################################
# WALLET
########################################
# Base58-encoded secret key of a DEDICATED BURNER WALLET.
# NEVER put your main wallet's key here. Fund it only with what you are
# fully prepared to lose.
WALLET_PRIVATE_KEY=""

########################################
# TRADING MODE / SAFETY
########################################
# Both must be explicitly "true" for the bot to ever send a real swap.
# Everything else defaults to paper trading (simulated, no funds moved).
LIVE_TRADING="false"
I_UNDERSTAND_THE_RISK="false"

MAX_POSITION_SOL="0.05"
MAX_DAILY_LOSS_SOL="0.2"
MAX_OPEN_POSITIONS="3"
SLIPPAGE_BPS="150"

# Comma-separated take-profit levels as "gainPercent:sellPercent"
# e.g. "50:25,100:25,200:50" = sell 25% at +50%, 25% at +100%, 50% at +200%
TAKE_PROFIT_LEVELS="50:25,100:25,200:50"
TRAILING_STOP_PERCENT="20"
STOP_LOSS_PERCENT="35"

########################################
# RISK / BUY THRESHOLDS
########################################
RISK_SCORE_MAX_TO_BUY="40"
SOCIAL_SCORE_MIN_TO_BUY="30"
MIN_LIQUIDITY_SOL="5"
MIN_HOLDERS="30"
MIN_SMART_WALLET_CO_BUYS="0"

########################################
# JUPITER (SWAP EXECUTION) — free "Lite" plan, signup required
########################################
# lite-api.jup.ag was deprecated Jan 31 2026 and replaced by the Jupiter
# Developer Platform. Its free "Lite" plan (25M credits/month, $0) is
# enough for a bot this size — get a key at https://developers.jup.ag/portal.
# The official @jup-ag/api client is used, which auto-selects the correct
# current endpoint for your key's tier.
JUPITER_API_KEY=""

########################################
# SOCIAL DATA SOURCES (all optional — features degrade gracefully if unset)
########################################
# TWITTER_BEARER_TOKEN: X API has no workable free read tier for this use
# case — leave blank for $0 operation. The bot runs fine without it; X
# signals just contribute nothing to the risk/social score instead of
# throwing errors.
TWITTER_BEARER_TOKEN=""
# TELEGRAM_BOT_TOKEN: 100% free — create one via @BotFather in Telegram,
# no payment tier exists for the Bot API at all.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ALERT_CHAT_ID=""
# HELIUS_API_KEY: optional, free tier is 1M credits/month ($0). Only used
# for faster smart-money wallet history lookups — without it, the bot
# falls back to plain RPC parsing (slower, still free, still works).
HELIUS_API_KEY=""
DISCORD_WIDGET_IDS=""

########################################
# API / DASHBOARD
########################################
API_PORT="3000"

########################################
# MISC
########################################
LOG_LEVEL="info"
